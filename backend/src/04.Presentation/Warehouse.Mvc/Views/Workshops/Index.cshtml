@model List<WarehouseApp.Domain.Core.Dtos.Workshop.GetAllWorkshopsDto>

@{
    ViewData["Title"] = "مدیریت کارگاه ها";
}


<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">مدیریت کارگاه ها</h3>
            <p class="text-muted mb-0">
                مشاهده، ایجاد، ویرایش و حذف کارگاه ها
            </p>
        </div>

        <a asp-controller="Workshops"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg ms-1"></i>
            ایجاد کارگاه جدید
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle ms-1"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle ms-1"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-semibold">
                    فهرست کارگاه ها
                </span>

                <span class="badge bg-secondary">
                    تعداد: @(Model?.Count ?? 0)
                </span>
            </div>
        </div>

        <div class="card-body p-0">

            @if (Model == null || Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-box-seam fs-1 text-muted"></i>

                    <p class="text-muted mt-3 mb-0">
                        کارگاهی ثبت نشده است.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>ردیف</th>
                                <th>نام کارگاه</th>
                                <th>شهر</th>
                                <th class="text-center">عملیات</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int rowNumber = 1;
                            }

                            @foreach (var workshop in Model)
                            {
                                <tr>
                                    <td>@rowNumber</td>

                                    <td class="fw-semibold">
                                        @workshop.Name
                                    </td>

                                    <td>
                                        @workshop.CityName
                                    </td>

                                    <td class="text-center">

                                        <a asp-controller="Workshops"
                                           asp-action="Edit"
                                           asp-route-id="@workshop.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square"></i>
                                            ویرایش
                                        </a>

                                        <form asp-controller="Workshops"
                                              asp-action="Delete"
                                              asp-route-id="@workshop.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('آیا از حذف این کارگاه اطمینان دارید؟');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                                حذف
                                            </button>
                                        </form>

                                    </td>
                                </tr>

                                rowNumber++;
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>