@{
    ViewData["Title"] = "ثبت نام موفق";
}

<div class="d-flex flex-column justify-content-center align-items-center text-center w-100"
     style="min-height: calc(100vh - 70px);
    background: linear-gradient(rgba(15, 23, 42, 0.75), rgba(15, 23, 42, 0.75)), url('/images/_common/FactoryImage.jpg') center/cover no-repeat;"
     dir="rtl">

    <div class="text-white p-5 rounded-3 shadow-lg w-100"
         style="backdrop-filter: blur(5px); background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255,255,255,0.2); max-width: 500px;">

        <div class="mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="72" height="72" class="text-warning" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8.515 1.019A7 7 0 0 0 8 1V0a8 8 0 0 1 .589.022l-.074.997zm2.004.45a7.003 7.003 0 0 0-.985-.299l.219-.976c.383.086.76.2 1.126.342l-.36.933zm1.37.71a7.01 7.01 0 0 0-.439-.27l.493-.87a8.025 8.025 0 0 1 .979.654l-.615.789a6.996 6.996 0 0 0-.418-.302zm1.834 1.79a6.99 6.99 0 0 0-.653-.796l.724-.69c.27.285.52.59.747.91l-.818.576zm.744 1.352a7.08 7.08 0 0 0-.214-.468l.893-.45a7.976 7.976 0 0 1 .45 1.088l-.95.313a7.023 7.023 0 0 0-.179-.483zm.53 2.507a6.991 6.991 0 0 0-.1-1.025l.985-.17c.067.386.106.778.116 1.17l-1 .025zm-.131 1.538c.033-.17.06-.339.081-.51l.993.123a7.957 7.957 0 0 1-.23 1.155l-.964-.267c.046-.165.086-.332.12-.501zm-.952 2.379c.184-.29.346-.594.486-.908l.914.405c-.16.36-.345.706-.555 1.038l-.845-.535zm-.964 1.205c.122-.122.239-.248.35-.378l.758.653a8.073 8.073 0 0 1-.401.432l-.707-.707z" />
                <path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
            </svg>
        </div>

        <h3 class="fw-bold mb-3">ثبت نام با موفقیت انجام شد</h3>

        <p class="text-light mb-5" style="line-height: 1.8;">
            اطلاعات شما در سیستم ثبت شد، اما حساب کاربری شما <strong>نیاز به تایید مدیریت</strong> دارد.
            <br />
            پس از بررسی و تایید حساب، می‌توانید وارد سیستم شوید.
        </p>

        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-lg px-5 py-3 shadow-sm rounded-pill fw-bold">
            بازگشت به صفحه اصلی
        </a>

    </div>
</div>