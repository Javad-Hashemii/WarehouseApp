@model ErrorViewModel

@{
    ViewData["Title"] = "خطا";
}

<div class="container text-center mt-5" dir="rtl">

    <h1 class="text-danger">
        خطایی رخ داده است
    </h1>

    <p class="lead">
        متأسفانه مشکلی در پردازش درخواست شما رخ داد.
    </p>

    @if (Model.ShowRequestId)
    {
        <p>
            کد پیگیری:
            <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-primary">
        بازگشت به صفحه اصلی
    </a>

</div>