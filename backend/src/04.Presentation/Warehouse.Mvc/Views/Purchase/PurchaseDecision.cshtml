@model Warehouse.Mvc.Models.Purchase.PurchaseDecisionViewModel

@{
    ViewData["Title"] = "تصمیم خرید";
}

<div class="container mt-4" dir="rtl">

    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">
                تصمیم خرید برای درخواست @Model.RequestNumber
            </h5>
        </div>

        <div class="card-body">

            <div class="alert alert-info">
                مقدار خرید هر کالا را مشخص کنید. همچنین می‌توانید کالای جدیدی به درخواست خرید اضافه کنید.
            </div>

            <div class="mb-3">
                <a asp-action="AddItem"
                   asp-route-requestId="@Model.RequestId"
                   asp-route-returnTo="PurchaseDecision"
                   class="btn btn-primary">
                    افزودن کالا
                </a>
            </div>

            <form asp-action="PurchaseDecision" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="RequestId" />

                <table class="table table-bordered align-middle text-center">

                    <thead>
                        <tr>
                            <th>کالا</th>
                            <th>واحد</th>
                            <th>مقدار درخواست شده</th>
                            <th>مقدار دریافت شده</th>
                            <th>کسری</th>
                            <th>مقدار خرید</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @for (var i = 0; i < Model.Items.Count; i++)
                        {
                            <tr>

                                <td>
                                    @Model.Items[i].ProductName

                                    <input type="hidden"
                                           asp-for="Items[i].RequestItemId" />

                                    <input type="hidden"
                                           asp-for="Items[i].ProductId" />

                                    <input type="hidden"
                                           asp-for="Items[i].ProductName" />

                                    <input type="hidden"
                                           asp-for="Items[i].Unit" />
                                </td>

                                <td>
                                    @Model.Items[i].Unit
                                </td>

                                <td>
                                    @Model.Items[i].QuantityRequested
                                </td>

                                <td>
                                    @Model.Items[i].QuantityReceived
                                </td>

                                <td>
                                    @Model.Items[i].QuantityShortage
                                </td>

                                <td style="width:180px;">
                                    <input asp-for="Items[i].QuantityToPurchase"
                                           type="number"
                                           min="0"
                                           step="0.001"
                                           class="form-control text-center" />
                                </td>

                                <td style="width:80px;">
                                    <button type="submit"
                                            formaction="@Url.Action("RemovePurchaseDecisionItem", "Requests")"
                                            formmethod="post"
                                            name="productId"
                                            value="@Model.Items[i].ProductId"
                                            formnovalidate
                                            class="btn btn-outline-danger btn-sm">
                                        حذف
                                    </button>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

                <div class="mt-4 d-flex justify-content-end">
                    <button type="submit"
                            class="btn btn-success">
                        تایید تصمیم خرید
                    </button>
                </div>

            </form>

        </div>

    </div>

</div>