@using WarehouseApp.Domain.Core.Consts
@using WarehouseApp.Domain.Core.Enums
@model Warehouse.Mvc.Models.Purchase.ApprovePurchaseRequestViewModel

@{
    ViewData["Title"] = "جزئیات درخواست خرید";

    var canApproveOrReject =
        User.IsInRole(Roles.CentralManager) &&
        Model.Status == PurchaseRequestStatus.PendingCentralOffice;
}

<div class="container mt-4" dir="rtl">

    <div class="card mb-4 shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h4 class="mb-0">
                درخواست خرید کارگاه: @Model.WorkshopName
            </h4>

            <a asp-controller="Purchase"
               asp-action="Index"
               class="btn btn-outline-secondary btn-sm">

                <i class="bi bi-arrow-right"></i>
                بازگشت

            </a>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">

                    <p>
                        <strong>شماره درخواست خرید:</strong>
                        @Model.PurchaseRequestNumber
                    </p>

                    <p>
                        <strong>شناسه درخواست خرید:</strong>
                        @Model.PurchaseRequestId
                    </p>

                </div>

                <div class="col-md-6">

                    <p>
                        <strong>وضعیت:</strong>
                        @Model.Status.ToString()
                    </p>

                    <p>
                        <strong>کارگاه:</strong>
                        @Model.WorkshopName
                    </p>

                </div>

            </div>

        </div>

    </div>


    <div class="card shadow-sm">

        <div class="card-header">

            <h5 class="mb-0">
                اقلام درخواست خرید
            </h5>

        </div>

        <div class="card-body">

            @if (Model.Items != null && Model.Items.Any())
            {
                <form asp-controller="Purchase"
                      asp-action="Approve"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="PurchaseRequestId" />
                    <input type="hidden" asp-for="PurchaseRequestNumber" />
                    <input type="hidden" asp-for="WorkshopName" />
                    <input type="hidden" asp-for="Status" />

                    <div class="table-responsive">

                        <table class="table table-bordered table-hover align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>شناسه محصول</th>
                                    <th>نام محصول</th>
                                    <th>واحد</th>
                                    <th>مقدار درخواست خرید</th>
                                    <th>مقدار تایید شده</th>
                                </tr>
                            </thead>

                            <tbody>

                                @for (var i = 0; i < Model.Items.Count; i++)
                                {
                                    <tr>

                                        <td>
                                            @Model.Items[i].ProductId

                                            <input type="hidden"
                                                   asp-for="Items[i].PurchaseRequestItemId" />

                                            <input type="hidden"
                                                   asp-for="Items[i].ProductId" />

                                            <input type="hidden"
                                                   asp-for="Items[i].ProductName" />

                                            <input type="hidden"
                                                   asp-for="Items[i].Unit" />

                                            <input type="hidden"
                                                   asp-for="Items[i].QuantityRequested" />
                                        </td>

                                        <td>
                                            @Model.Items[i].ProductName
                                        </td>

                                        <td>
                                            @Model.Items[i].Unit
                                        </td>

                                        <td>
                                            @Model.Items[i].QuantityRequested
                                        </td>

                                        <td style="width:200px;">

                                            <input asp-for="Items[i].QuantityApproved"
                                                   type="number"
                                                   min="0"
                                                   max="@Model.Items[i].QuantityRequested"
                                                   step="0.001"
                                                   class="form-control text-center" />

                                            <span asp-validation-for="Items[i].QuantityApproved"
                                                  class="text-danger small">
                                            </span>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>


                    @if (canApproveOrReject)
                    {
                        <div class="d-flex justify-content-end mt-4">

                            <button type="submit"
                                    class="btn btn-success px-4">

                                <i class="bi bi-check-circle me-1"></i>
                                تایید درخواست خرید

                            </button>

                        </div>
                    }

                </form>


                @if (canApproveOrReject)
                {
                    <div class="d-flex justify-content-end mt-2">

                        <form asp-controller="Purchase"
                              asp-action="Deny"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.PurchaseRequestId" />

                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="bi bi-x-circle me-1"></i>
                                رد کامل درخواست خرید

                            </button>

                        </form>

                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-4">
                    هیچ آیتمی یافت نشد.
                </div>
            }

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}