{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "SiteSettings": {
    "ConnectionStrings": {
      "Sql": "Server=(localdb)\\MSSQLLocalDB;Initial Catalog=WarehouseDb;Integrated Security=True;Connect Timeout=30;Encrypt=True;Trust Server Certificate=False;Application Intent=ReadWrite;Multi Subnet Failover=False;Command Timeout=30"
    },

    "CacheSettings": {
      "AbsoluteExpirationHours": 12,
      "SlidingExpirationHours": 12
    },
    "WarehouseConfigurations": {
      "PaginationSettings": {
        "DefaultPageSize": 8,
        "MaxPageSize": 20,
        "ServicePageSizes": 3,
        "ProductPageSize": 5,
        "RequestsPageSize": 5
      }
    },
    "FileSettings": {
      "MaxFileSizeMB": 5,
      "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
    }
  }
}
